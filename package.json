{
  "name": "monaco-json-studio-triple",
  "version": "1.0.0",
  "description": "Three-pane Monaco JSON Studio built on monaco-json-studio-base.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/monaco-json-studio-triple.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
